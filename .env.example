# =============================================================================
# Hedron — Environment template
# =============================================================================
# Copy to `.env` and fill in your values.
# NEVER commit `.env`. Placeholders only in this file.
# All keys/ids below are example placeholders. Real values stay local.
# =============================================================================

# -----------------------------------------------------------------------------
# Hedera network / operator
# -----------------------------------------------------------------------------
# testnet | previewnet | mainnet (Hedron defaults to testnet; mainnet is opt-in)
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxx
# Use ED25519 or ECDSA (raw 64-hex or DER 302e02...). Never commit a real key.
HEDERA_OPERATOR_KEY=REPLACE_ME
# Optional mirror node override (https://mainnet-public.mirrornode.hedera.com etc.)
HEDERA_MIRROR_NODE_URL=

# -----------------------------------------------------------------------------
# HCS topics (auto-provisioned on first run when missing; pin in prod)
# -----------------------------------------------------------------------------
# Audit trail for commerce flow events (INTENT_CREATED ... RECEIPT_ISSUED)
HEDRON_HCS_AUDIT_TOPIC_ID=0.0.xxxxx
# Receipt registry (verifiable receipts as final artifacts)
HEDRON_HCS_RECEIPT_TOPIC_ID=0.0.xxxxx
# Optional policy decision topic; if empty, decisions go on the audit topic.
HEDRON_HCS_POLICY_TOPIC_ID=

# -----------------------------------------------------------------------------
# Router / Broker runtime
# -----------------------------------------------------------------------------
HEDRON_ROUTER_HTTP_HOST=0.0.0.0
HEDRON_ROUTER_HTTP_PORT=4080
HEDRON_BROKER_HTTP_PORT=4081
# Comma-separated list of trusted agent identity ids that may register
HEDRON_TRUSTED_AGENT_IDS=
# Idempotency key TTL in seconds (replay-protection window)
HEDRON_IDEMPOTENCY_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Policy engine
# -----------------------------------------------------------------------------
HEDRON_POLICY_MAX_PRICE_HBAR=10
HEDRON_POLICY_MAX_DAILY_SPEND_HBAR=100
HEDRON_POLICY_REQUIRE_APPROVAL_OVER_HBAR=5
HEDRON_POLICY_ALLOWED_PAYMENT_RAILS=hedera-hbar,hedera-hts,x402
HEDRON_POLICY_DEFAULT=deny

# -----------------------------------------------------------------------------
# Settlement
# -----------------------------------------------------------------------------
# Default rail when an intent does not pin one: hedera-hbar | hedera-hts | x402
HEDRON_DEFAULT_PAYMENT_RAIL=hedera-hbar
# HTS token id for stablecoin settlement (e.g., USDC on Hedera) — optional
HEDRON_HTS_SETTLEMENT_TOKEN_ID=0.0.xxxxx

# -----------------------------------------------------------------------------
# x402 facilitator (Hedera exact scheme)
# -----------------------------------------------------------------------------
# Hedron x402 facilitator URL. Leave blank to disable the x402 rail. Use a
# hosted Hedera-capable facilitator or your own self-hosted one.
#
# Known-good testnet (open access, no API key, verified 2026-07-31):
#   https://api.testnet.blocky402.com   → hedera:testnet, feePayer 0.0.7162784
#
# CAUTION: https://api.blocky402.com (without `testnet.`) also returns 200 on
# /supported but advertises hedera:MAINNET with a different fee payer and needs
# an API key. Both hosts answer, so a reachability check will not catch the
# mistake — only the CAIP-2 network in the response body differs.
HEDRON_X402_FACILITATOR_URL=
# Optional bearer token; open-access facilitators need none.
HEDRON_X402_FACILITATOR_API_KEY=
# testnet | mainnet — mapped internally to the CAIP-2 ids the protocol requires
# (hedera:testnet / hedera:mainnet).
HEDRON_X402_NETWORK=testnet
# Hedera account that RECEIVES x402 payments (the resource server's payTo).
HEDRON_X402_PAY_TO=0.0.xxxxx
# Facilitator account that sponsors network fees (PaymentRequirements.extra.feePayer).
# Leave blank to discover it from the facilitator's GET /supported response.
HEDRON_X402_FEE_PAYER=

# -----------------------------------------------------------------------------
# EVM (optional, off by default)
# -----------------------------------------------------------------------------
EVM_RPC_URL=
EVM_CHAIN_ID=
EVM_SETTLEMENT_PRIVATE_KEY=REPLACE_ME
EVM_USDC_CONTRACT=
EVM_MERCHANT_ADDRESS=

# -----------------------------------------------------------------------------
# Daydreams adapter
# -----------------------------------------------------------------------------
DAYDREAMS_AGENT_ID=
DAYDREAMS_API_BASE_URL=
DAYDREAMS_API_KEY=

# -----------------------------------------------------------------------------
# Hedera Agent Kit plugin (v4)
# -----------------------------------------------------------------------------
HAK_PLUGIN_ENABLED=false
HAK_LLM_PROVIDER=
HAK_LLM_API_KEY=

# -----------------------------------------------------------------------------
# Demo / test flags
# -----------------------------------------------------------------------------
# Opt-in switches — default off so CI never needs real credentials
RUN_HEDERA_INTEGRATION=false
RUN_EVM_INTEGRATION=false
DEMO_MODE=mock

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=pretty
